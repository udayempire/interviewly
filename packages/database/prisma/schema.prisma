generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  name             String?
  authProvider     AuthProvider
  createdAt        DateTime            @default(now())
  accounts         UserAccount[]
  interview        Interview[]
  interviewReport  InterviewReport[]
  userProfile      UserProfile?
  credit           UserCredit?
  creditTransactions CreditTransaction[]
  // plan            Plan?             @default(FREE)
  // nextBillingDate DateTime?
}

model UserAccount {
  id               String       @id @default(cuid())
  userId           String
  provider         AuthProvider
  providerId       String? // null for email
  passwordHash     String? //only for email password
  createdAt        DateTime     @default(now())
  user             User         @relation(fields: [userId], references: [id])
  providerImageUrl String? // profile picture gave by google/github

  @@unique([userId, provider])
  @@unique([provider, providerId])
}

model UserProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  githubUrl       String?     @unique
  githubData      Json?
  resumeText      Json?
  resumePdf       Bytes?
  llmProvider     String?
  llmApiKey       String?
  useCustomKey    Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
  interviews      Interview[]
  profileImageUrl String? // profile picture gave by user later
  user            User        @relation(fields: [userId], references: [id])
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Template {
  id             String         @id @default(cuid())
  name           String
  description    String?
  createdById    String
  isPublic       Boolean
  templateSource TemplateSource
  config         Json?
  createdAt      DateTime       @default(now())
  interviews     Interview[]
}

model Interview {
  id          String             @id @default(cuid())
  userId      String
  profileId   String?
  templateId  String?
  mode        AIMode
  status      InterviewStatus    @default(IN_PROGRESS)
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  description String?
  githubData  Json?
  joinCode    String?
  resumeText  Json?
  profile     UserProfile?       @relation(fields: [profileId], references: [id])
  template    Template?          @relation(fields: [templateId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  messages    InterviewMessage[]
  report      InterviewReport?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
}

model InterviewMessage {
  id          String         @id @default(cuid())
  interviewId String
  role        MessageRole
  content     String
  audioUrl    String?
  questionNum Int?
  type        InterviewType?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  interview   Interview      @relation(fields: [interviewId], references: [id])
}

model InterviewReport {
  id               String    @id @default(cuid())
  userId           String
  interviewId      String    @unique
  strengths        String[]
  improvements     String[]
  detailedFeedback String
  aiSummary        String
  overallScore     Int?
  breakdown        Json?
  createdAt        DateTime  @default(now())
  interview        Interview @relation(fields: [interviewId], references: [id])
  user             User      @relation(fields: [userId], references: [id])
}

model LLMCall {
  id            String   @id @default(cuid())
  interviewId   String?
  userId        String?
  operation     String // what operation is being performed
  llmProvider   String
  llmModel      String
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  estimatedCost Decimal?
  status        String
  errorCode     String?
  createdAt     DateTime @default(now())

  @@index([interviewId])
  @@index([userId])
  @@index([llmModel])
  @@index([llmProvider])
  @@index([createdAt])
}

enum MessageRole {
  ASSISTANT
  USER
}

enum InterviewType {
  BEHAVIOURAL
  TECHNICAL
  CODING
}

enum AIMode {
  TEXT
  VOICE
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum TemplateSource {
  PLATFORM
  USER
}

// ─── Credits system ────────────────────────────────────────────────────────────
// Internal unit: MINUTES (stored as Int — no decimals, no precision issues).
// "1 credit" shown to users = 15 minutes in the DB.
// A 17-minute interview deducts 17, not 1.133.
// UI layer converts: displayCredits = floor(balance / MINUTES_PER_CREDIT)

model UserCredit {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0) // minutes available (not credits)
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model CreditTransaction {
  id          String                @id @default(cuid())
  userId      String
  delta       Int                   // minutes: positive = add, negative = deduct
  type        CreditTransactionType
  note        String?               // human-readable reason, e.g. "signup bonus (30 min)", "17 min interview"
  interviewId String?               // set when type = DEDUCTED or REFUNDED
  grantedBy   String?               // admin userId when type = GIFTED or ADMIN_ADJUSTMENT
  createdAt   DateTime              @default(now())
  user        User                  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([interviewId])
}

enum CreditTransactionType {
  SIGNUP_BONUS       // free credits on account creation
  GIFTED             // manually gifted by admin
  PURCHASED          // user bought a pack (future)
  DEDUCTED           // interview started / consumed credits
  REFUNDED           // interview failed / refunded credits
  EXPIRED            // subscription cycle reset (future)
  ADMIN_ADJUSTMENT   // manual correction by admin
}
